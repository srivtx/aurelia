# ============================================================
# AURELIA — environment variables (server-side only)
# Copy this file to .env.local and fill in what you want.
# Keys NEVER reach the client: they are read only by the
# /api/stylist Node-runtime route.
# Full guide: docs/DEPLOYMENT.md
# ============================================================

# ── AI providers (all optional) ────────────────────────────
# The server auto-detects the first configured key in this
# priority order: groq → gemini → openrouter → cerebras →
# mistral → custom. The built-in "Aurelia Cloud" model is the
# always-available fallback, so the chat never goes down.
# End users never see which provider is serving them.

# Groq — fastest free tier (~30 req/min, 1k req/day)
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — best free quality/limit ratio (~10 req/min)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — one key, 16+ free models (:free suffix)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — extreme speed, small free trial
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral — free Experiment tier (~1 req/sec)
# https://console.mistral.ai
MISTRAL_API_KEY=

# ── Optional pins (server-side routing) ────────────────────
# Force one provider (groq|gemini|openrouter|cerebras|mistral|custom|zai)
# AI_PROVIDER=groq
# Force one model id at that provider
# AI_MODEL=openai/gpt-oss-20b

# ── Custom OpenAI-compatible endpoint (Ollama, LM Studio, vLLM…) ──
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.2

# ── Database (unused by the app today, Prisma scaffold) ────
# DATABASE_URL="file:./db/custom.db"
